{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Run Brew App on iOS Simulator",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run"
			],
			"isBackground": true,
			"problemMatcher": []
		},
		{
			"label": "Run Brew App web preview",
			"type": "shell",
			"command": "flutter",
			"args": [
				"run",
				"-d",
				"web-server",
				"--web-port=8123",
				"--web-hostname=127.0.0.1"
			],
			"isBackground": true,
			"problemMatcher": []
		}
	]
}